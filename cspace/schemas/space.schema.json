{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space",
  "description": "A versioned conceptual box: K (nodes) interpreted under C (context). An edge A -> B means B's recorded justification or construction uses A. supports [[A, B], [D]] means 'A and B together, or D'.",
  "type": "object",
  "required": ["id", "version", "parent_version", "context", "nodes"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 0},
    "parent_version": {"type": ["integer", "null"]},
    "context": {
      "type": "object",
      "required": ["fixed_requirements", "editable_priors", "permitted_constructions"],
      "properties": {
        "fixed_requirements": {"type": "array", "items": {"type": "string"}},
        "editable_priors": {"type": "array", "items": {"type": "string"}},
        "permitted_constructions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "statement", "scope", "sources", "status", "active", "supports"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "type": {"enum": ["definition", "assumption", "theorem", "empirical_claim", "method"]},
        "statement": {"type": "string"},
        "scope": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["established", "supported", "conditional", "disputed", "unresolved", "suspended"]},
        "active": {"type": "boolean", "description": "True for commitments active in the current formulation; false for background knowledge and known alternatives."},
        "supports": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
